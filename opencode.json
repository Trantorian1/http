{
  "$schema": "https://opencode.ai/config.json",
  "model": "unsloth/qwen3.8",
  "formatter": {
    "rustfmt": {
      "command": [
        "rustfmt",
        "$FILE"
      ],
      "extensions": [
        ".rs"
      ]
    },
    "alejandra": {
      "command": [
        "alejandra",
        "$FILE"
      ],
      "extensions": [
        ".nix"
      ]
    }
  },
  "permissions": [
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ]
}
